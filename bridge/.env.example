# Copy to .env and fill in. Never commit the real file (.env is gitignored).
# Load it with: set -a; source .env; set +a; npm start   (or use your host's secret manager)

# --- Required ---
# Bot token from "OAuth & Permissions" after installing the app (xoxb-... or, with token rotation, xoxe.xoxb-...).
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
# App-level token from "Basic Information" > "App-Level Tokens", with the connections:write scope (xapp-1-...).
# Needed for Socket Mode. App-level tokens do not rotate.
SLACK_APP_TOKEN=xapp-1-REPLACE_ME

# --- Optional: act as you instead of the bot ---
# User token from "OAuth & Permissions" > "User OAuth Token" (xoxp-... or xoxe.xoxp-...).
# When set, messages/reactions/read-marks are performed as this user.
SLACK_USER_TOKEN=

# --- Optional: token rotation (apps created with "Token Rotation" enabled) ---
# Client ID and Client Secret are on the app's "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Refresh token(s) (xoxe-1-...). SLACK_REFRESH_TOKEN refreshes the bot token; SLACK_USER_REFRESH_TOKEN the user token.
# If your app only has a user token, put its refresh token in SLACK_REFRESH_TOKEN; the bridge detects the token type.
SLACK_REFRESH_TOKEN=
SLACK_USER_REFRESH_TOKEN=
# Where the newest refresh tokens are persisted between restarts (gitignored). Default: ./.tokens.json
SLACK_TOKEN_STORE=./.tokens.json

# --- Bridge ---
BRIDGE_PORT=8787
# Comma-separated list of browser origins allowed to call the bridge (CORS). localhost is always allowed.
BRIDGE_ALLOWED_ORIGINS=https://imagine-os.github.io
# Shared secret the shell must send as "Authorization: Bearer <secret>" (and ?token= on the WebSocket).
# Generate one with: openssl rand -hex 24
BRIDGE_SHARED_SECRET=REPLACE_ME
